[]<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Painel Catálogo TMDB</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen pb-24">

  <!-- Cabeçalho -->
  <header class="bg-slate-900 border-b border-slate-800 p-4 sticky top-0 z-10 flex justify-between items-center">
    <h1 class="text-lg font-bold text-emerald-400">🎬 Meu Catálogo API</h1>
    <span id="status" class="text-xs text-slate-400">Pronto</span>
  </header>

  <main class="p-4 max-w-md mx-auto space-y-6">

    <!-- ABA 1: ADICIONAR -->
    <section id="aba-adicionar" class="space-y-4">
      <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 space-y-3">
        <label class="block text-sm font-medium text-slate-300">Buscar no TMDB por ID ou Nome</label>
        <div class="flex gap-2">
          <input id="busca-tmdb" type="text" placeholder="Ex: 603 ou Matrix" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-emerald-500">
          <select id="tipo-tmdb" class="bg-slate-800 border border-slate-700 rounded-lg px-2 py-2 text-sm">
            <option value="movie">Filme</option>
            <option value="tv">Série</option>
          </select>
          <button onclick="buscarTMDB()" class="bg-emerald-600 hover:bg-emerald-500 px-4 py-2 rounded-lg text-sm font-semibold">Buscar</button>
        </div>
      </div>

      <!-- Prévia do Filme Encontrado -->
      <div id="preview-card" class="hidden bg-slate-900 p-4 rounded-xl border border-slate-800 space-y-3">
        <div class="flex gap-3">
          <img id="prev-poster" src="" class="w-20 h-28 object-cover rounded-lg bg-slate-800">
          <div class="space-y-1">
            <h2 id="prev-titulo" class="font-bold text-base"></h2>
            <p id="prev-info" class="text-xs text-slate-400"></p>
            <span id="prev-id" class="inline-block bg-slate-800 text-emerald-400 text-xs px-2 py-0.5 rounded"></span>
          </div>
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Link do Vídeo / Player (MP4, M3U8, Embed)</label>
          <input id="link-video" type="url" placeholder="https://..." class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm">
        </div>
        <button onclick="salvarFilme()" class="w-full bg-emerald-600 hover:bg-emerald-500 py-2.5 rounded-lg font-bold text-sm">💾 Salvar no GitHub</button>
      </div>
    </section>

    <!-- ABA 2: BIBLIOTECA -->
    <section id="aba-biblioteca" class="hidden space-y-3">
      <div class="flex justify-between items-center">
        <h2 class="font-bold text-base">Itens Salvos (<span id="total-itens">0</span>)</h2>
        <button onclick="carregarBiblioteca()" class="text-xs text-emerald-400 underline">Atualizar</button>
      </div>
      <div id="lista-filmes" class="space-y-2"></div>
    </section>

    <!-- ABA 3: CONFIGURAÇÕES -->
    <section id="aba-config" class="space-y-4">
      <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 space-y-3">
        <h2 class="font-bold text-base text-emerald-400">Chaves de Conexão</h2>
        <div>
          <label class="block text-xs text-slate-400 mb-1">API Key do TMDB (v3 ou Token)</label>
          <input id="cfg-tmdb" type="text" placeholder="Cole sua chave do TMDB" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Token do GitHub (ghp_...)</label>
          <input id="cfg-gh-token" type="password" placeholder="Cole seu ghp_..." class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Usuário do GitHub</label>
          <input id="cfg-gh-user" type="text" value="dasilvacostab486-code" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Nome do Repositório</label>
          <input id="cfg-gh-repo" type="text" value="meu-catalogo" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm">
        </div>
        <button onclick="salvarConfig()" class="w-full bg-blue-600 hover:bg-blue-500 py-2.5 rounded-lg font-bold text-sm">Guardar Configurações</button>
      </div>
      <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 space-y-2">
        <p class="text-xs text-slate-400">Link da sua API para colocar no seu aplicativo:</p>
        <input id="link-api-app" readonly class="w-full bg-slate-950 border border-slate-800 rounded p-2 text-xs text-emerald-400">
      </div>
    </section>

  </main>

  <!-- Barra de Navegação Inferior -->
  <nav class="fixed bottom-0 inset-x-0 bg-slate-900 border-t border-slate-800 flex justify-around py-2 text-xs">
    <button onclick="mudarAba('adicionar')" id="btn-adicionar" class="flex flex-col items-center text-emerald-400 font-semibold">➕<span>Adicionar</span></button>
    <button onclick="mudarAba('biblioteca')" id="btn-biblioteca" class="flex flex-col items-center text-slate-400">📚<span>Biblioteca</span></button>
    <button onclick="mudarAba('config')" id="btn-config" class="flex flex-col items-center text-slate-400">⚙️<span>Configurar</span></button>
  </nav>

  <script>
    let itemAtual = null;

    function setStatus(texto) {
      document.getElementById('status').innerText = texto;
    }

    function carregarConfig() {
      const tmdb = localStorage.getItem('tmdb_key') || '';
      const token = localStorage.getItem('gh_token') || '';
      const user = localStorage.getItem('gh_user') || 'dasilvacostab486-code';
      const repo = localStorage.getItem('gh_repo') || 'meu-catalogo';

      document.getElementById('cfg-tmdb').value = tmdb;
      document.getElementById('cfg-gh-token').value = token;
      document.getElementById('cfg-gh-user').value = user;
      document.getElementById('cfg-gh-repo').value = repo;
      document.getElementById('link-api-app').value = `https://githubusercontent.com{user}/${repo}/main/filmes.json`;

      if (tmdb && token) {
        mudarAba('adicionar');
      } else {
        mudarAba('config');
      }
    }

    function salvarConfig() {
      localStorage.setItem('tmdb_key', document.getElementById('cfg-tmdb').value.trim());
      localStorage.setItem('gh_token', document.getElementById('cfg-gh-token').value.trim());
      localStorage.setItem('gh_user', document.getElementById('cfg-gh-user').value.trim());
      localStorage.setItem('gh_repo', document.getElementById('cfg-gh-repo').value.trim());
      carregarConfig();
      alert('Configurações salvas com sucesso!');
    }

    function mudarAba(aba) {
      ['adicionar', 'biblioteca', 'config'].forEach(id => {
        document.getElementById('aba-' + id).classList.add('hidden');
        document.getElementById('btn-' + id).classList.remove('text-emerald-400', 'font-semibold');
        document.getElementById('btn-' + id).classList.add('text-slate-400');
      });
      document.getElementById('aba-' + aba).classList.remove('hidden');
      document.getElementById('btn-' + aba).classList.add('text-emerald-400', 'font-semibold');
      document.getElementById('btn-' + aba).classList.remove('text-slate-400');

      if (aba === 'biblioteca') carregarBiblioteca();
    }

    async function buscarTMDB() {
      const key = localStorage.getItem('tmdb_key');
      if (!key) {
        alert('Cole sua API Key do TMDB na aba Configurar primeiro!');
        mudarAba('config');
        return;
      }

      const query = document.getElementById('busca-tmdb').value.trim();
      const tipo = document.getElementById('tipo-tmdb').value;
      if (!query) return;

      setStatus('Buscando...');
      const isId = /^\d+$/.test(query);
      const isBearer = key.length > 40;

      let url = isId
        ? `https://themoviedb.org{tipo}/${query}?language=pt-BR`
        : `https://themoviedb.org{tipo}?query=${encodeURIComponent(query)}&language=pt-BR`;

      const headers = {};
      if (isBearer) {
        headers['Authorization'] = `Bearer ${key}`;
      } else {
        url += `&api_key=${key}`;
      }

      try {
        const res = await fetch(url, { headers });
        const data = await res.json();
        const item = isId ? data : (data.results && data.results[0]);

        if (!item || item.success === false) {
          alert('Não encontrado no TMDB. Verifique sua chave ou o nome/ID.');
          setStatus('Erro na busca');
          return;
        }

        itemAtual = {
          id: item.id,
          tipo: tipo,
          titulo: item.title || item.name,
          sinopse: item.overview || '',
          poster: item.poster_path ? `https://tmdb.org{item.poster_path}` : '',
          fundo: item.backdrop_path ? `https://tmdb.org{item.backdrop_path}` : '',
          ano: (item.release_date || item.first_air_date || '').slice(0, 4),
          nota: item.vote_average ? item.vote_average.toFixed(1) : '0.0'
        };

        document.getElementById('prev-poster').src = itemAtual.poster;
        document.getElementById('prev-titulo').innerText = itemAtual.titulo;
        document.getElementById('prev-info').innerText = `${itemAtual.ano} • Nota: ${itemAtual.nota}`;
        document.getElementById('prev-id').innerText = `ID: ${itemAtual.id}`;
        document.getElementById('preview-card').classList.remove('hidden');
        setStatus('Encontrado!');
      } catch (e) {
        alert('Erro de conexão com o TMDB.');
        setStatus('Erro');
      }
    }

    async function obterArquivoGitHub() {
      const token = localStorage.getItem('gh_token');
